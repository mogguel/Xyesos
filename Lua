RunService.RenderStepped:Connect(function()
    -- Очистка старых зонтиков
    for _, v in pairs(UmbrellaFolder:GetChildren()) do
        v:Destroy()
    end

    local enemy, dist = GetClosestEnemy()
    ClosestEnemy = enemy

    -- Уведомление
    if Settings.EnemyAlert and enemy and dist <= 15 then
        AlertLabel.Visible = true
    else
        AlertLabel.Visible = false
    end

    -- Зонтик
    if Settings.UmbrellaESP and enemy and enemy.Character and enemy.Character:FindFirstChild("Head") then
        local head = enemy.Character.Head
        local bb = Instance.new("BillboardGui")
        bb.Size = UDim2.new(0, 60, 0, 60)
        bb.StudsOffset = Vector3.new(0, 3.2, 0)
        bb.AlwaysOnTop = true
        bb.Adornee = head
        bb.Parent = UmbrellaFolder

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.Text = "☂️"
        label.TextColor3 = Color3.fromRGB(0, 255, 120)
