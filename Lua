        label.Font = Enum.Font.GothamBold
        label.Parent = bb

        -- Неоновое свечение
        local stroke = Instance.new("UIStroke")
        stroke.Color = Color3.fromRGB(0, 255, 140)
        stroke.Thickness = 2
        stroke.Transparency = 0.3
        stroke.Parent = label
    end

    -- Tracer
    if TracerLine then
        if Settings.Tracers and enemy and enemy.Character and enemy.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local from = Camera:WorldToViewportPoint(LocalPlayer.Character.HumanoidRootPart.Position)
            local to = Camera:WorldToViewportPoint(enemy.Character.HumanoidRootPart.Position)
            if from.Z > 0 and to.Z > 0 then
                TracerLine.From = Vector2.new(from.X, from.Y)
                TracerLine.To = Vector2.new(to.X, to.Y)
                TracerLine.Visible = true
            else
                TracerLine.Visible = false
            end
        else
            TracerLine.Visible = false
        end
    end
end)

-- Aimbot + Silent Aim
RunService.RenderStepped:Connect(function()
    if not (Settings.Aimbot or Settings.SilentAim) then return end
    if not ClosestEnemy or not ClosestEnemy.Character then return end

    local targetPart = ClosestEnemy.Character:FindFirstChild(Settings.AimPart) or ClosestEnemy.Character:FindFirstChild("HumanoidRootPart")
    if not targetPart then return end

    local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
    if not onScreen then return end

    local distToCrosshair = (Vector2.new(Mouse.X, Mouse.Y) - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
    if distToCrosshair > Settings.AimFOV then return end

    if Settings.Aimbot then
        local lookAt = CFrame.lookAt(Camera.CFrame.Position, targetPart.Position)
        Camera.CFrame = Camera.CFrame:Lerp(lookAt, Settings.AimSmooth)
    end

    if Settings.SilentAim then
        -- Базовый silent (камера + лёгкий lock)
        local lookAt = CFrame.lookAt(Camera.CFrame.Position, targetPart.Position)
        Camera.CFrame = Camera.CFrame:Lerp(lookAt, 0.35)
    end
end)

